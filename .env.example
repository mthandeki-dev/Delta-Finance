# Delta Finance — environment variable reference
# Copy to .env.local for local development. Never commit .env.local.
# For Netlify: set these in Dashboard → Site configuration → Environment variables.

# ── Database ──────────────────────────────────────────────────────────
# Supabase / any hosted Postgres. Use pooler URL (port 6543) for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
# Direct connection (port 5432) used only for Prisma db push / migrations — not required at runtime.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ── Secrets ───────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
SESSION_SECRET="change-me-to-32+-random-chars"
NEXTAUTH_SECRET="change-me-to-different-32+-random-chars"

# ── URLs ──────────────────────────────────────────────────────────────
# Localhost:
NEXTAUTH_URL="http://localhost:3000"
# APP_URL and INTERNAL_URL default to localhost:3000 when not set.
# Netlify: set only NEXTAUTH_URL — APP_URL and INTERNAL_URL are auto-detected
#          from Netlify's injected URL env var, so you don't need to set them.
# APP_URL="https://YOUR-SITE.netlify.app"      # optional on Netlify
# INTERNAL_URL="https://YOUR-SITE.netlify.app" # optional on Netlify

# ── RBAC ──────────────────────────────────────────────────────────────
# Comma-separated XRPL addresses that become ADMIN on Xaman sign-in.
ADMIN_XRPL_ADDRESSES="rYourXrplAddressHere"

# ── Xaman (human admin wallet) — https://apps.xaman.dev ───────────────
XAMAN_API_KEY="your-xaman-api-key"
XAMAN_API_SECRET="your-xaman-api-secret"

# ── Privy (agent wallet) — https://dashboard.privy.io ─────────────────
PRIVY_APP_ID="your-privy-app-id"
PRIVY_APP_SECRET="your-privy-app-secret"

# ── Agent ─────────────────────────────────────────────────────────────
# Shared secret for machine callers of POST /api/agent and the internal x402 gateway.
AGENT_API_KEY="generate-a-long-random-key"
# Optional: enables LLM intent parsing. Without it the app uses the deterministic parser.
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-haiku-4-5"
# Enables the red-team demo mode. Use only on a private testnet demo.
ALLOW_REDTEAM_DEMO="false"

# ── XRPL / RLUSD (Testnet defaults — no change needed for testnet) ─────
XRPL_WSS="wss://s.altnet.rippletest.net:51233"
XRPL_FAUCET_URL="https://faucet.altnet.rippletest.net/accounts"
RLUSD_ISSUER="rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV"

# ── t54 x402 facilitator ───────────────────────────────────────────────
T54_FACILITATOR_URL="https://xrpl-facilitator-testnet.t54.ai"
T54_SOURCE_TAG="804681468"
# Set to "true" to bypass t54 and submit the signed blob directly to XRPL (demo fallback only).
X402_DIRECT_SUBMIT_FALLBACK="false"

# ── Display only ───────────────────────────────────────────────────────
# Indicative local-currency equivalent shown next to RLUSD amounts. Never used for settlement.
DISPLAY_FX_CODE="ZAR"
DISPLAY_FX_RATE=""
