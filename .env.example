# ── Core ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://delta:delta@localhost:5432/delta_finance?schema=public"
# 32+ random bytes: openssl rand -base64 48
SESSION_SECRET="change-me"
# Public URL of the app (used for Xaman return links)
APP_URL="http://localhost:3000"
# URL the agent uses to reach the x402 settlement gateway (same container by default)
INTERNAL_URL="http://127.0.0.1:3000"

# ── RBAC ─────────────────────────────────────────────────────────────
# Comma-separated XRPL addresses that become ADMIN on Xaman sign-in. Everyone else is a read-only VIEWER.
ADMIN_XRPL_ADDRESSES="rYourXamanTestnetAddress"

# ── Xaman (human admin wallet) — https://apps.xaman.dev ──────────────
XAMAN_API_KEY=""
XAMAN_API_SECRET=""

# ── Privy (agent wallet) — https://dashboard.privy.io ────────────────
PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# ── Agent ────────────────────────────────────────────────────────────
# Shared secret for machine callers of POST /api/agent and for the internal x402 gateway
AGENT_API_KEY="change-me-too"
# Optional. Without it the agent uses the deterministic parser only.
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-haiku-5-5"
# Enables the "red-team" demo: skip the app router and prove Privy's policy engine refuses to sign.
ALLOW_REDTEAM_DEMO="true"

# ── XRPL / RLUSD (Testnet defaults) ──────────────────────────────────
XRPL_WSS="wss://s.altnet.rippletest.net:51233"
XRPL_FAUCET_URL="https://faucet.altnet.rippletest.net/accounts"
RLUSD_ISSUER="rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV"

# ── t54 x402 facilitator ─────────────────────────────────────────────
T54_FACILITATOR_URL="https://xrpl-facilitator-testnet.t54.ai"
T54_SOURCE_TAG="804681468"
# If the facilitator is unreachable (NOT if it denies), submit the already-signed blob directly. Demo safety net.
X402_DIRECT_SUBMIT_FALLBACK="false"

# ── Display only ─────────────────────────────────────────────────────
# Indicative local-currency equivalent shown next to RLUSD amounts. Never used for settlement.
DISPLAY_FX_CODE="ZAR"
DISPLAY_FX_RATE=""
