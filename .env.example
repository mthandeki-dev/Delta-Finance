# Delta Finance — environment variable reference
# Copy to .env.local for local development. Never commit .env.local.
# For Netlify: set these in Dashboard → Site configuration → Environment variables.

# ── Database ──────────────────────────────────────────────────────────
# Supabase / any hosted Postgres. Use pooler URL (port 6543) for the app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true"
# Direct connection (port 5432) used only for Prisma db push / migrations — not required at runtime.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ── Secrets ───────────────────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
SESSION_SECRET="change-me-to-32+-random-chars"
NEXTAUTH_SECRET="change-me-to-different-32+-random-chars"

# ── URLs ──────────────────────────────────────────────────────────────
# Localhost:
NEXTAUTH_URL="http://localhost:3000"
# APP_URL and INTERNAL_URL default to localhost:3000 when not set.
# Netlify: set only NEXTAUTH_URL — APP_URL and INTERNAL_URL are auto-detected
#          from Netlify's injected URL env var, so you don't need to set them.
# APP_URL="https://YOUR-SITE.netlify.app"      # optional on Netlify
# INTERNAL_URL="https://YOUR-SITE.netlify.app" # optional on Netlify

# ── RBAC ──────────────────────────────────────────────────────────────
# Comma-separated XRPL addresses that become ADMIN on Xaman sign-in.
ADMIN_XRPL_ADDRESSES="rYourXrplAddressHere"

# ── Xaman (human admin wallet) — https://apps.xaman.dev ───────────────
XAMAN_API_KEY="your-xaman-api-key"
XAMAN_API_SECRET="your-xaman-api-secret"

# ── Privy (agent wallet) — https://dashboard.privy.io ─────────────────
PRIVY_APP_ID="your-privy-app-id"
PRIVY_APP_SECRET="your-privy-app-secret"
# Public verification key for validating Privy access tokens (from Privy Dashboard → App settings → Verification key).
# PEM format, e.g.: "-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\nyour-key-here\n-----END PUBLIC KEY-----"

# ── Agent ─────────────────────────────────────────────────────────────
# Shared secret for machine callers of POST /api/agent and the internal x402 gateway.
AGENT_API_KEY="generate-a-long-random-key"
# Optional: enables LLM intent parsing. Without it the app uses the deterministic parser.
ANTHROPIC_API_KEY=""
LLM_MODEL="claude-haiku-4-5"
# Optional: Lelapa AI Vulavula — African-language speech-to-text and translation.
# Sign up (free tier, no card) at vulavula.lelapa.ai → Dashboard → API Keys.
# STT languages: isiZulu (with code-switching), Sesotho, Afrikaans, South African English.
# Translation languages: all of the above + isiXhosa.
# When set, Vulavula is used for both STT and translation; it takes priority over Google and the LLM.
VULAVULA_API_KEY=""
# Optional: Google Cloud Speech-to-Text and Translation (fallback when Vulavula is not set).
# Create an API key at console.cloud.google.com → APIs & Services → Credentials.
# Enable: Cloud Speech-to-Text API and Cloud Translation API.
GOOGLE_CLOUD_API_KEY=""

# ── XRPL / RLUSD (Testnet defaults — no change needed for testnet) ─────
XRPL_WSS="wss://s.altnet.rippletest.net:51233"
XRPL_FAUCET_URL="https://faucet.altnet.rippletest.net/accounts"
RLUSD_ISSUER="rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV"

# ── t54 x402 facilitator ───────────────────────────────────────────────
T54_FACILITATOR_URL="https://xrpl-facilitator-testnet.t54.ai"
T54_SOURCE_TAG="804681468"
# Set to "true" to bypass t54 and submit the signed blob directly to XRPL (demo fallback only).
X402_DIRECT_SUBMIT_FALLBACK="false"

# ── Verification gate ──────────────────────────────────────────────────
# ZAR per 1 RLUSD, used only for the per-user spending threshold check. Never used for settlement.
# Defaults to 18 if not set.
FX_ZAR_PER_RLUSD="18"

# ── Display only ───────────────────────────────────────────────────────
# Indicative local-currency equivalent shown next to RLUSD amounts. Never used for settlement.
DISPLAY_FX_CODE="ZAR"
DISPLAY_FX_RATE=""

# ── Inventory restock notifications (Gmail SMTP) ───────────────────────
# Use a Google account with 2FA enabled. Generate an App Password at:
# https://myaccount.google.com/apppasswords
GMAIL_USER="you@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
# Comma-separated list of additional notification recipients (optional).
FINANCE_ADMIN_EMAILS="cfo@company.com,ops@company.com"

# ── Post-quantum field encryption ─────────────────────────────────────
# Generate a fresh key pair with:  npx tsx scripts/generate-pq-keys.ts
# Never commit real keys to the repo. Store them in your hosting secrets manager.
# PQ_KEY_ID can be any non-empty string (e.g. "v1", "v2"). Use a different value each time you rotate.
# After rotation: move the outgoing key to PREVIOUS so old rows can still be read.
PQ_PUBLIC_KEY=""
PQ_SECRET_KEY=""
PQ_KEY_ID=""
# Optional — needed only after a key rotation until all rows have been re-encrypted.
PQ_SECRET_KEY_PREVIOUS=""
PQ_KEY_ID_PREVIOUS=""

# ── Playwright (external web orders) ──────────────────────────────────
# Set to "true" to simulate orders without actually placing them (safe for demos).
PLAYWRIGHT_DRY_RUN="true"
# Set to "false" to watch the browser window (useful for debugging).
PLAYWRIGHT_HEADLESS="true"
